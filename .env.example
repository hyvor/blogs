### ============ APP ============ ###

# Environment the app is running.
#   "local" - for development
#   "staging" - for staging deployments
#   "production" - for production deployments
APP_ENV=production

# Laravel encryption key
# This key must be the same for all hyvor components (core, talk, blogs)
# It is used to encrypt sensitive data and secure internal communication between components
# Run `php artisan key:generate --show` to generate the key
APP_KEY=

# Enable/disable debugging
# Only set to true on non-production envs
APP_DEBUG=false

# URL of the APP
# Only supported https
# For most production deployments, keep it empty
APP_URL=

# Domains of the app

# Main app domain
DOMAIN_APP=blogs.hyvor.com
# Domain for delivery (subdomain blogs)
DOMAIN_DELIVERY=hyvorblogs.io


### ============ HYVOR ============ ###

# HYVOR
# https://github.com/hyvor/hyvor-internal?tab=readme-ov-file#configuration
AUTH_PROVIDER=hyvor
AUTH_HYVOR_URL=https://hyvor.com # deprecated
AUTH_HYVOR_PRIVATE_URL=https://hyvor.com # deprecated


### ============ DATABASE ============ ###

# MYSQL
# ----
# This is the primary source of truth for the app
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=


# Meilisearch
# ----
# Used as the search index
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=
MEILISEARCH_KEY=


### ============ Laravel ============ ###

# Use the database for the queue
QUEUE_CONNECTION=database
# Use the database for the cache
CACHE_DRIVER=database


### ============ FILE STORAGE ============ ###

# You can use any S3-compatibly storage like
# Cloudflare R2, DigitalOcean Spaces, Minio
# See https://hyvor.com/docs/hosting/handbook#file-storage
FILESYSTEM_DRIVER=s3
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_BUCKET=
S3_USE_PATH_STYLE_ENDPOINT=true


### ============ MAIL ============ ###

# See https://hyvor.com/docs/hosting/handbook#mail
MAIL_MAILER=smtp # for transactional emails
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=


### ============ EXTERNAL SERVICES ============ ###

# Iframely for link previews
IFRAMELY_KEY=

# Unsplash for image search
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=

# DeepL
# Used for translations
DEEPL_API_KEY=

# OpenAI
# Used for AI-powered features
OPENAI_API_KEY=

# Sentry
# Used for error tracking
SENTRY_LARAVEL_DSN=


### ============ CLOUD-ONLY ============ ###

PADDLE_VENDOR_ID=
PADDLE_PUBLIC_KEY=
PADDLE_AUTH_KEY=
PADDLE_SANDBOX=

HYVOR_TALK_API_KEY=

# Github themes webhook
GITHUB_THEMES_PUBLISH_KEY=

# Newsletter
EMAIL_OCTOPUS_API_KEY=