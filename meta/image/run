#!/bin/sh

# Run migrations if enabled
if [ "${RUN_MIGRATIONS_ON_STARTUP:-true}" = "true" ]; then
    php /app/backend/bin/console doctrine:migrations:migrate --no-interaction --allow-no-migration
fi

# Extract delivery domain from DELIVERY_URL
DELIVERY_DOMAIN=$(echo "$DELIVERY_URL" | sed -E 's#https?://##' | sed 's#/##g')
export DELIVERY_DOMAIN

# Configure the app domain's Caddy address/TLS directive from TLS_MODE
# auto:     Caddy manages a Let's Encrypt certificate automatically
# manual:   the certificate/key mounted at /certs/cert.pem and /certs/key.pem are used to serve TLS
# external: TLS is terminated by a reverse proxy in front; the container only serves HTTP
# disabled: no TLS at all, no https redirect
TLS_MODE="${TLS_MODE:-auto}"

case "$TLS_MODE" in
    auto)
        APP_ADDRESS="$DOMAIN_APP"
        # without this, Caddy tries to use get_certificate
        APP_TLS_DIRECTIVE="tls certificates@example.com"
        ;;
    manual)
        APP_ADDRESS="$DOMAIN_APP"
        APP_TLS_DIRECTIVE="tls /certs/cert.pem /certs/key.pem"
        ;;
    external)
        APP_ADDRESS="$DOMAIN_APP:80"
        APP_TLS_DIRECTIVE=""
        ;;
    disabled)
        APP_ADDRESS="$DOMAIN_APP:80"
        APP_TLS_DIRECTIVE=""
        ;;
    *)
        echo "Invalid TLS_MODE: $TLS_MODE. Must be one of: auto, external, manual, disabled." >&2
        exit 1
        ;;
esac

export APP_ADDRESS
export APP_TLS_DIRECTIVE

# Configure FrankenPHP's built-in Mercure hub (if MERCURE_INTERNAL=true)
# https://frankenphp.dev/docs/mercure
MERCURE_INTERNAL="${MERCURE_INTERNAL:-true}"

if [ "$MERCURE_INTERNAL" = "true" ]; then
    if [ "$TLS_MODE" = "disabled" ]; then
        APP_SCHEME="http"
    else
        APP_SCHEME="https"
    fi

    export MERCURE_URL="http://localhost:8081/.well-known/mercure"
    export MERCURE_PUBLIC_URL="${APP_SCHEME}://${DOMAIN_APP}/.well-known/mercure"
    export MERCURE_DIRECTIVE="mercure {
    publisher_jwt ${MERCURE_JWT_SECRET}
    subscriber_jwt ${MERCURE_JWT_SECRET}
}"
else
    export MERCURE_DIRECTIVE=""
fi

# Run supervisor
/usr/bin/supervisord -c /etc/supervisor/conf.d/supervisord.conf
