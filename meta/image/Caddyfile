{
	frankenphp
    log {
        output stderr
        level {$LOG_LEVEL}
    }
    metrics
    auto_https disable_redirects
}

(handle_php) {
	root * /app/backend/public
	encode zstd gzip
	php_server {
        file_server off
        worker {
			file /app/backend/public/index.php
		}
        env CADDY_ROUTER {args[0]}
    }
}

(marketing_redirects) {
	# ?query of the request, to be appended to the redirect URL
	@has_query expression {query} != ""
	vars @has_query query_suffix ?{query}

	import docs_redirects
	import marketing_redirects_{$DEPLOYMENT:on-prem}
}

# docs are served at hyvor.com/blogs/docs and hyvor.com/blogs/hosting (in all deployments)
# they are only rendered in this app in dev
(docs_redirects) {
	# /fr/docs/tags -> https://hyvor.com/fr/blogs/docs/tags
	@docs path_regexp docs ^(/fr)?/(docs|hosting)((?:/[^/]+)*)/?$
	redir @docs https://hyvor.com{re.docs.1}/blogs/{re.docs.2}{re.docs.3}{vars.query_suffix} 301
}

# old marketing pages moved to hyvor.com/blogs
(marketing_redirects_cloud) {
	# translated pages keep the language (/fr/pricing -> https://hyvor.com/fr/blogs/pricing)
	@marketing path_regexp marketing ^(/fr)?(/pricing|/eu|/multi-language|/self-hosted)?/?$
	redir @marketing https://hyvor.com{re.marketing.1}/blogs{re.marketing.2}{vars.query_suffix} 301

	# English-only pages (/fr/terms -> https://hyvor.com/blogs/terms)
	@marketing_en path_regexp marketing_en ^(?:/fr)?(/themes|/terms|/privacy)/?$
	redir @marketing_en https://hyvor.com/blogs{re.marketing_en.1}{vars.query_suffix} 301

	# integrations pages were removed
	@marketing_integrations path_regexp ^(?:/fr)?/integrations(?:/.*)?$
	redir @marketing_integrations https://hyvor.com/blogs{vars.query_suffix} 301
}

(marketing_redirects_on-prem) {
	# self-hosted instances only serve the console
	redir / /console{vars.query_suffix} 302
}

# hyvorblogs.io subdomain
# see run script for DELIVERY_DOMAIN
*.{$DELIVERY_DOMAIN}:80 {
	import handle_php subdomain
}

# main app
# see run script for APP_ADDRESS / APP_TLS_DIRECTIVE (from TLS_MODE)
{$APP_ADDRESS}, http://localhost:8081{$APP_ADDRESS_ADDITIONAL} {

	{$APP_TLS_DIRECTIVE}
	{$MERCURE_DIRECTIVE}

	@noindex {
		path /console*
		path /sudo*
	}
	header @noindex X-Robots-Tag "noindex, nofollow"

	import marketing_redirects

	@backend {
		path /api/*
		path /blog/*
	}

	handle @backend {
		import handle_php app
	}

	@static {
		file
		path *.ico *.css *.js *.gif *.webp *.avif *.jpg *.jpeg *.png *.svg *.woff *.woff2 *.mov
	}

	# static files
	handle {
		root * /app/static
		file_server {
			pass_thru
		}
		encode zstd gzip
		try_files {path} {path}.html
		header @static Cache-Control max-age=5184000
	}

	# fallback
	handle {
		root * /app/static
		encode zstd gzip
		file_server
		header Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
		rewrite * /fallback.html
	}
}

# local endpoints
http://localhost:8080 {
	import handle_php local
}

# custom domain
:443, :80 {
	tls {
		get_certificate http http://localhost:8080/api/local/caddy-certificate
	}
	import handle_php customdomain
}

# caddy / frankenphp metrics
:9666 {
    metrics
}
