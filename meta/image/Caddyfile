{
	on_demand_tls {
		ask https://{$DOMAIN_APP}/api/special/caddy/allowed-domain
	}
}

# hyvorblogs.io subdomain
*.{$DELIVERY_DOMAIN}:80 {
	root * /app/backend/public
	encode zstd gzip
	php_fastcgi unix//run/php-fpm.sock
	try_files index.php
}

# main app
{$DOMAIN_APP}:80 {
	handle /api/* {
		root * /app/backend/public
		php_fastcgi unix//run/php-fpm.sock
		try_files index.php
	}
	handle {
		root * /app/static
		file_server {
			pass_thru
		}
		encode zstd gzip
		try_files {path} {path}.html
	}
	handle {
		root * /app/static
		encode zstd gzip
		file_server
		rewrite * /200.html
	}
}

# custom domain
http://, https:// {
	tls {
		on_demand
	}

	root * /app/backend/public
	encode zstd gzip
	php_fastcgi unix//run/php-fpm.sock
	try_files index.php
}
