# Taken from here:
# https://github.com/laravel/octane/blob/2.x/src/Commands/stubs/Caddyfile
# ENV variables are coming from here: https://github.com/laravel/octane/blob/2.x/src/Commands/StartFrankenPhpCommand.php#L92

{
	frankenphp
	http_port 80

	on_demand_tls {
        ask http://localhost:8080/api/special/caddy/allowed-domain
    }

    log {
        output stderr
        level {$LOG_LEVEL}
    }

    metrics
}

# hyvorblogs.io subdomain
# see run script for DELIVERY_DOMAIN
*.{$DELIVERY_DOMAIN}:80 {
	root * /app/backend/public
	encode zstd gzip
	php_server {
        file_server off
        root /app/backend/public/
        try_files index.php
    }
}

# main app
{$DOMAIN_APP}:80 {

	handle /api/* {
		root * /app/backend/public
        encode zstd gzip
        php_server {
            file_server off
            try_files index.php
        }
	}

	@static {
		file
		path *.ico *.css *.js *.gif *.webp *.avif *.jpg *.jpeg *.png *.svg *.woff *.woff2 *.mov
	}
	header @static Cache-Control max-age=5184000

	# static files
	handle {
		root * /app/static
		file_server {
			pass_thru
		}
		encode zstd gzip
		try_files {path} {path}.html
	}

	# fallback
	handle {
		root * /app/static
		encode zstd gzip
		file_server
		header Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
		rewrite * /200.html
	}
}

# custom domain
:443 {
	tls {
		on_demand
	}

	root * /app/backend/public
	encode zstd gzip
	php_server {
        file_server off
        root /app/backend/public/
        env LARAVEL_OCTANE 1
        env FRANKENPHP_WORKER 1
        worker frankenphp-worker.php
    }
}
