{
	frankenphp

	on_demand_tls {
        ask http://localhost:8080/api/special/caddy/allowed-domain
    }

    log {
        output stderr
        level {$LOG_LEVEL}
    }

    metrics
}

# hyvorblogs.io subdomain
# see run script for DELIVERY_DOMAIN
*.{$DELIVERY_DOMAIN}:80 {
	root * /app/backend/public
	encode zstd gzip
	php_server {
        file_server off
        worker {
			file /app/backend/public/index.php
		}
    }
}

# main app
# see run script for APP_ADDRESS / APP_TLS_DIRECTIVE (from TLS_MODE)
{$APP_ADDRESS} {

	{$APP_TLS_DIRECTIVE}

	handle /api/* {
		root * /app/backend/public
        encode zstd gzip
        php_server {
            file_server off
            worker {
				file /app/backend/public/index.php
			}
        }
	}

	@static {
		file
		path *.ico *.css *.js *.gif *.webp *.avif *.jpg *.jpeg *.png *.svg *.woff *.woff2 *.mov
	}
	header @static Cache-Control max-age=5184000

	# static files
	handle {
		root * /app/static
		file_server {
			pass_thru
		}
		encode zstd gzip
		try_files {path} {path}.html
	}

	# fallback
	handle {
		root * /app/static
		encode zstd gzip
		file_server
		header Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
		rewrite * /fallback.html
	}
}

# custom domain
:443 {
	tls {
		on_demand
	}
	root * /app/backend/public
	encode zstd gzip
	php_server {
        file_server off
        worker {
			file /app/backend/public/index.php
		}
    }
}
