# Taken from here:
# https://github.com/laravel/octane/blob/2.x/src/Commands/stubs/Caddyfile
# ENV variables are coming from here: https://github.com/laravel/octane/blob/2.x/src/Commands/StartFrankenPhpCommand.php#L92

{
	frankenphp {
		worker "/app/backend/public/frankenphp-worker.php" {$CADDY_SERVER_WORKER_COUNT}
	}

	on_demand_tls {
        ask http://localhost:8989/api/special/caddy/allowed-domain
    }

    log {
        output stderr
        level {$LOG_LEVEL}
    }

    metrics
}

:9666 {
    metrics
}

:9667 {
    root * /app/backend/public
    php_server {
        file_server off
        env HYVOR_METRICS_SERVER 1
        try_files frankenphp-worker.php
    }
}

# hyvorblogs.io subdomain
*.{$DELIVERY_DOMAIN}:80 {
	root * /app/backend/public
	encode zstd gzip
	php_server {
        file_server off
        try_files frankenphp-worker.php
    }
}

# main app
{$DOMAIN_APP}:80, :8989 {
    @symfony {
        path /api/comms/*
    }
    handle @symfony {
        root * /app/symfony/public
        encode zstd gzip
        php_server {
            file_server off
            try_files index.php
        }
    }

    @laravel {
        path /api/*
    }
	handle @laravel {
		root * /app/backend/public
		encode zstd gzip
		php_server {
            file_server off
            try_files {path} frankenphp-worker.php
        }
	}

	@static {
		file
		path *.ico *.css *.js *.gif *.webp *.avif *.jpg *.jpeg *.png *.svg *.woff *.woff2 *.mov
	}
	header @static Cache-Control max-age=5184000

	# static files
	handle {
		root * /app/static
		file_server {
			pass_thru
		}
		encode zstd gzip
		try_files {path} {path}.html
	}

	# fallback
	handle {
		root * /app/static
		encode zstd gzip
		file_server
		header Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
		rewrite * /200.html
	}
}

# custom domain
http://, https:// {
	tls {
		on_demand
	}

	root * /app/backend/public
	encode zstd gzip
	php_server {
       file_server off
       try_files frankenphp-worker.php
    }
}