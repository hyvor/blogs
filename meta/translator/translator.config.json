            "shortname": "marketing"
        },
        {
            "source": "../../frontend/src/routes/(marketing)/[[lang]]/docs/[[slug]]/content/*.md",
            "target": "../../frontend/src/routes/(marketing)/[[lang]]/docs/[[slug]]/{lang}/*.md",
            "shortname": "docs"
        },
        {
            "source": "../../frontend/src/routes/(marketing)/[[lang]]/hosting/content/*.md",
            "target": "../../frontend/src/routes/(marketing)/[[lang]]/hosting/{lang}/*.md",
            "shortname": "hosting"
        }
    ],
    "ignore": []
}
