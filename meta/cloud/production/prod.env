# HYVOR Instance URL
# Set this to URL where HYVOR Core is running
HYVOR_INSTANCE=https://hyvor.com

APP_NAME="Hyvor Blogs"
APP_ENV=production
APP_KEY="op://engineering-production/hyvor-app-keys/laravel-app-key"
APP_DEBUG=false
#empty because subdomain routing doesn't work without empty
APP_URL=

DOMAIN_APP=blogs-new.hyvor.com
DELIVERY_DOMAIN=hyvorblogs.io
DELIVERY_URL=https://hyvorblogs.io
DOMAIN_HYVOR=hyvor.com

# HYVOR Connecter (deprecated)
HYVOR_URL_PUBLIC="op://engineering-production/hyvor-auth-api/public-url" # deprecated
# HYVOR_URL="op://engineering-production/hyvor-auth-api/private-url" # deprecated
HYVOR_URL="op://engineering-production/hyvor-auth-api/public-url"
HYVOR_API_KEY="op://engineering-production/hyvor-auth-api/credential" #deprecated
HYVOR_DUMMY=false #deprecated

APP_DOMAIN=${DOMAIN_APP}
AUTH_PROVIDER=hyvor
AUTH_HYVOR_URL="op://engineering-production/hyvor-auth-api/public-url"
AUTH_HYVOR_PRIVATE_URL="op://engineering-production/hyvor-auth-api/public-url"
AUTH_HYVOR_API_KEY="op://engineering-production/hyvor-auth-api/credential"

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST="op://engineering-production/hyvor-blogs-pgsql/server"
DB_PORT="op://engineering-production/hyvor-blogs-pgsql/port"
DB_DATABASE="op://engineering-production/hyvor-blogs-pgsql/database"
DB_USERNAME="op://engineering-production/hyvor-blogs-pgsql/username"
DB_PASSWORD="op://engineering-production/hyvor-blogs-pgsql/password"

MYSQL_DB_HOST="op://engineering-production/hyvor-blogs-mysql/server"
MYSQL_DB_PORT="op://engineering-production/hyvor-blogs-mysql/port"
MYSQL_DB_DATABASE="op://engineering-production/hyvor-blogs-mysql/database"
MYSQL_DB_USERNAME="op://engineering-production/hyvor-blogs-mysql/username"
MYSQL_DB_PASSWORD="op://engineering-production/hyvor-blogs-mysql/password"

BROADCAST_DRIVER=log
CACHE_DRIVER=database
FILESYSTEM_DRIVER=s3
QUEUE_CONNECTION=database

### SAAS

MAIL_MAILER=mailgun
MAILGUN_DOMAIN="op://engineering-production/mailgun/username"
MAILGUN_SECRET="op://engineering-production/mailgun/credential"

S3_ACCESS_KEY_ID="op://engineering-production/digitalocean-spaces/access-key-id"
S3_SECRET_ACCESS_KEY="op://engineering-production/digitalocean-spaces/secret-access-key"
S3_DEFAULT_REGION="op://engineering-production/digitalocean-spaces/default-region"
S3_ENDPOINT="op://engineering-production/digitalocean-spaces/endpoint"
S3_USE_PATH_STYLE_ENDPOINT=false
S3_BUCKET=hyvor-blogs-cdn
S3_URL="op://engineering-production/digitalocean-spaces/url"

PADDLE_VENDOR_ID="op://engineering-production/hyvor-blogs-paddle/vendor-id"
PADDLE_VENDOR_AUTH_CODE="op://engineering-production/hyvor-blogs-paddle/auth-code"
PADDLE_PUBLIC_KEY="op://engineering-production/hyvor-blogs-paddle/public-key"
PADDLE_SANDBOX=false

# IFRAMELY_KEY="op://engineering-production/iframely/credential"

UNSPLASH_ACCESS_KEY="op://engineering-production/unsplash/access-key"
UNSPLASH_SECRET_KEY="op://engineering-production/unsplash/secret-key"

GITHUB_THEMES_PUBLISH_KEY="op://engineering-production/hyvor-blogs-app-keys/github-themes-publish-key"

EMAIL_OCTOPUS_API_KEY="op://engineering-production/email-octopus/credential"

DEEPL_API_KEY="op://engineering-production/deepl/credential"

HYVOR_TALK_API_KEY="op://engineering-production/hyvor-blogs-app-keys/hyvor-talk-key"

OPENAI_API_KEY="op://engineering-production/openai/credential"

SENTRY_LARAVEL_DSN="op://engineering-production/hyvor-blogs-app-keys/sentry-dns"


# SHOPIFY_API_KEY=
# SHOPIFY_API_SECRET_KEY=
