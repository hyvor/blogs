### ============ APP ============ ###

# Environment the app is running.
#   "local" - for development
#   "staging" - for staging deployments
#   "production" - for production deployments
APP_ENV=staging

# Laravel encryption key
# This key must be the same for all hyvor components (core, talk, blogs)
# It is used to encrypt sensitive data and secure internal communication between components
# Run `php artisan key:generate --show` to generate the key
APP_KEY="op://engineering-staging/hyvor-app-keys/laravel-app-key"

# Enable/disable debugging
# Only set to true on non-production envs
APP_DEBUG=false

# URL of the APP
# Only supported https
# For most production deployments, keep it empty
APP_URL=

# Domains of the app

# Main app domain
DOMAIN_APP=blogs.hyvorstaging.com
# Domain for delivery (subdomain blogs)
DOMAIN_DELIVERY=userblogs.hyvorstaging.com


### ============ HYVOR ============ ###

# HYVOR
# https://github.com/hyvor/hyvor-internal?tab=readme-ov-file#configuration
AUTH_PROVIDER=hyvor
AUTH_HYVOR_URL=https://hyvorstaging.com # deprecated
AUTH_HYVOR_PRIVATE_URL=https://hyvorstaging.com # deprecated


### ============ DATABASE ============ ###

# MYSQL
# ----
# This is the primary source of truth for the app
DB_CONNECTION=mysql
DB_HOST=hb-mysql
DB_PORT=3306
DB_DATABASE=hyvor_blogs
DB_USERNAME=mysql
DB_PASSWORD=mysql


# Meilisearch
# ----
# Used as the search index
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://hb-meilisearch:7700
MEILISEARCH_KEY=MASTER_KEY


### ============ Laravel ============ ###

# Use the database for the queue
QUEUE_CONNECTION=database
# Use the database for the cache
CACHE_DRIVER=database


### ============ FILE STORAGE ============ ###

# You can use any S3-compatibly storage like
# Cloudflare R2, DigitalOcean Spaces, Minio
# See https://hyvor.com/docs/hosting/handbook#file-storage
FILESYSTEM_DRIVER=s3
S3_ACCESS_KEY_ID="op://engineering-staging/cloudflare-r2-staging/access-key-id"
S3_SECRET_ACCESS_KEY="op://engineering-staging/cloudflare-r2-staging/secret-access-key"
S3_ENDPOINT="op://engineering-staging/cloudflare-r2-staging/endpoint"
S3_BUCKET=hyvorstaging-blogs
S3_USE_PATH_STYLE_ENDPOINT=false
S3_DEFAULT_REGION=weur


### ============ MAIL ============ ###

# See https://hyvor.com/docs/hosting/handbook#mail
MAIL_MAILER=smtp
MAIL_HOST="op://engineering-staging/staging-mailgun-smtp/hostname"
MAIL_PORT=op://engineering-staging/staging-mailgun-smtp/port
MAIL_USERNAME="op://engineering-staging/staging-mailgun-smtp/username"
MAIL_PASSWORD="op://engineering-staging/staging-mailgun-smtp/password"
MAIL_FROM_ADDRESS=blogs@outgoing.hyvorstaging.com
MAIL_FROM_NAME="Hyvor Blogs (Staging)"


### ============ EXTERNAL SERVICES ============ ###

# Iframely for link previews
IFRAMELY_KEY="op://engineering-staging/iframely-staging/credential"

# Unsplash for image search
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=

# DeepL
# Used for translations
DEEPL_API_KEY=

# OpenAI
# Used for AI-powered features
OPENAI_API_KEY=

# Sentry
# Used for error tracking
SENTRY_LARAVEL_DSN=


### ============ CLOUD-ONLY ============ ###

PADDLE_VENDOR_ID=
PADDLE_PUBLIC_KEY=
PADDLE_AUTH_KEY=
PADDLE_SANDBOX=

# deprecated
HYVOR_TALK_API_KEY="op://engineering-staging/staging-services/hb-ht-key"

# Github themes webhook
GITHUB_THEMES_PUBLISH_KEY=

# Newsletter
EMAIL_OCTOPUS_API_KEY=