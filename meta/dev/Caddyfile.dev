{
	frankenphp
    metrics
    auto_https disable_redirects
}

(handle_php) {
    root /app/backend/public
    php_server {
        file_server off
        try_files index.php
        env CADDY_ROUTER {args[0]}
    }
}

# the main app
:80 {

    @subdomain {
        host *.hyvorblogs.localhost
    }

    handle @subdomain {
        import handle_php subdomain
    }

    handle {
        import handle_php app
    }

	log {
        output stderr
        level DEBUG
    }

}

# local endpoints
http://localhost:8080 {
    import handle_php local
}

# custom domain testing
:443 {
    tls {
        get_certificate http http://localhost:8080/api/local/caddy-certificate
    }

    import handle_php customdomain
}
