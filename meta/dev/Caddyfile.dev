{
	frankenphp
    metrics
}

:80 {

    @symfony {
        path /api/comms/*
        path /api/sudo/*
        path /api/v2/*
    }
    handle @symfony {
        root /app/symfony/public
        php_server {
            file_server off
            try_files index.php
        }
    }

    # laravel
    handle {
        root /app/backend/public
        php_server {
            file_server off
            try_files index.php
        }
    }

	log {
        output file /var/log/caddy.log
    }

}
