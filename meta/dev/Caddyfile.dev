{
	frankenphp
    metrics
    auto_https disable_redirects
}

(handle_php) {
    root /app/backend/public
    php_server {
        file_server off
        try_files index.php
    }
}

# the main app
:80 {

    @subdomain {
        host *.hyvorblogs.localhost
    }

    handle @subdomain {
        request_header X-Router subdomain
        import handle_php
    }

    handle {
        import handle_php
    }

	log {
        output stderr
        level DEBUG
    }

}

# local endpoints
http://localhost:8080 {
    request_header X-Router local
    import handle_php
}

# custom domain testing
:443 {
    tls {
        get_certificate http http://localhost:8080/api/local/caddy-certificate
    }

    request_header X-Router customdomain
    import handle_php
}