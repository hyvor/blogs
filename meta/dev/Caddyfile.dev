{
	frankenphp
    metrics
}

:80 {

    @symfony {
        path /api/comms/*
        path /api/sudo/*
        path /api/v2/*
        path /api/oidc/*

        # need to update this as routes are migrated to Symfony
        # also update image Caddyfile
        path /api/console/v0/init
        path /api/console/v0/usage
        path /api/console/v0/blogs/sort
        path /api/console/v0/blog/check-subdomain
        
        path /api/console/v0/blog/*/api-keys
        path /api/console/v0/blog/*/api-key/*

        path /api/console/v0/blog/*/languages
        path /api/console/v0/blog/*/language/*

        path /api/console/v0/blog/*/navigations
        path /api/console/v0/blog/*/navigation/*

        path /api/console/v0/blog/*/redirects
        path /api/console/v0/blog/*/redirect/*

        path /api/console/v0/blog/*/routes
        path /api/console/v0/blog/*/route/*

        path /api/console/v0/blog/*/webhooks
        path /api/console/v0/blog/*/webhook/*
    }
    handle @symfony {
        root /app/symfony/public
        php_server {
            file_server off
            try_files index.php
        }
    }

    # laravel
    handle {
        root /app/backend/public
        php_server {
            file_server off
            try_files index.php
        }
    }

	log {
        output file /var/log/caddy.log
    }

}
