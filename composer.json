{
    "name": "hyvor/blogs",
    "type": "project",
    "description": "Hyvor Blogs",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "ext-dom": "*",
        "ext-intl": "*",
        "erusev/parsedown-extra": "^0.8.1",
        "fruitcake/laravel-cors": "^2.0",
        "guzzlehttp/guzzle": "^7.0.1",
        "http-interop/http-factory-guzzle": "^1.2",
        "hyvor/laravel-filterq": "^1.0",
        "hyvor/laravel-hyvor-connecter": "^1.1.2",
        "hyvor/laravel-json-meta": "0.0.3",
        "hyvor/php-svg-icons": "1.0.0",
        "hyvor/scssphp": "2.0.1",
        "laravel/cashier-paddle": "^1.4",
        "laravel/framework": "^9.0",
        "laravel/scout": "^9.4",
        "laravel/telescope": "^4.6",
        "laravel/tinker": "^2.7",
        "league/flysystem-aws-s3-v3": "^3.0",
        "masterminds/html5": "^2.7",
        "meilisearch/meilisearch-php": "^0.23.1",
        "nelexa/zip": "^4.0",
        "padaliyajay/php-autoprefixer": "^1.3",
        "predis/predis": "^1.1",
        "scrivo/highlight.php": "v9.18.1.9",
        "symfony/css-selector": "^6.0",
        "symfony/dom-crawler": "^6.0",
        "symfony/http-foundation": "^6.0",
        "symfony/process": "^6.0",
        "symfony/yaml": "^6.0",
        "twig/intl-extra": "^3.4",
        "twig/string-extra": "^3.3",
        "twig/twig": "^2.0",
        "ueberdosis/tiptap-php": "^1.1",
        "unsplash/unsplash": "^3.2",
        "vlucas/phpdotenv": "^5.4"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.6",
        "fakerphp/faker": "^1.9.1",
        "friendsofphp/php-cs-fixer": "^3.8",
        "laravel/sail": "^1.0.1",
        "mockery/mockery": "^1.4.2",
        "nunomaduro/collision": "^6.0",
        "pestphp/pest": "^1.21",
        "pestphp/pest-plugin-laravel": "^1.2",
        "pestphp/pest-plugin-mock": "^1.0",
        "pestphp/pest-plugin-parallel": "^1.0",
        "phpstan/phpstan": "^1.5",
        "phpunit/phpunit": "^9.3.3",
        "spatie/laravel-ignition": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Project\\": "src/",
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",

            "Database\\Seeders\\": "database/seeders/",

            "Hyvor\\SyntaxHighlighter\\": "packages/highlighter/src/"
        },

        "Database\\Seeders\\": "database/seeders/",
        "Hyvor\\Auth\\": "packages/hyvor/auth/src/",
        "Hyvor\\FilterQ\\": "packages/hyvor/filter-q"
        
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],

        "serve": "concurrently \"php artisan serve --host=blogs.hyvor.test --port=8080\" \"php artisan serve --host=test.hyvorblogs.test --port=8081\"",
        "expose": "ngrok http 8080 --host-header=blogs.hyvor.test",
        "test": "vendor/bin/pest -p",
        "coverage": "vendor/bin/pest --coverate -p",
        "fix": "vendor/bin/php-cs-fixer fix --allow-risky=yes",
        "minio": "minio server storage/app/minio"
    },
    "repositories": [
        {"type": "composer", "url": "https://hyvor.repo.repman.io"}
    ],
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
