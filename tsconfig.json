{
    "compilerOptions": {
        "baseUrl": "./",
        "noImplicitAny": true,
        "module": "CommonJS",
        "target": "es5",
        "sourceMap": true,
        "jsx": "react",
        "allowJs": true,
        "moduleResolution": "node",
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "strict": true,
        "skipLibCheck": true,
        "allowImportingTsExtensions": true
    },
    "include": ["resources/js", "e2e"]
}