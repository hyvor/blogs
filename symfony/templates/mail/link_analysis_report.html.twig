{% extends '@Internal/mail/mail.html.twig' %}

{% block title %}{{ subject }}{% endblock %}
{% block heading %}Link Analysis Report{% endblock %}

{% block content %}
    <p>Hi,</p>
    <p>
        Link analysis for <strong>{{ blogUrl }}</strong> has finished.
        Here is a summary of the results:
    </p>

    <table cellpadding="0" cellspacing="0" style="width:100%;margin:15px 0;font-size:14px;">
        <tr>
            <td style="padding:6px 0;">Posts checked</td>
            <td style="padding:6px 0;text-align:right;font-weight:600;">{{ postsCount }}</td>
        </tr>
        <tr>
            <td style="padding:6px 0;">Total links</td>
            <td style="padding:6px 0;text-align:right;font-weight:600;">{{ linksTotalCount }}</td>
        </tr>
        <tr>
            <td style="padding:6px 0;color:#c0392b;">Broken</td>
            <td style="padding:6px 0;text-align:right;font-weight:600;color:#c0392b;">{{ linksBrokenCount }}</td>
        </tr>
        <tr>
            <td style="padding:6px 0;">Risky</td>
            <td style="padding:6px 0;text-align:right;font-weight:600;">{{ linksRiskyCount }}</td>
        </tr>
        <tr>
            <td style="padding:6px 0;">Redirects</td>
            <td style="padding:6px 0;text-align:right;font-weight:600;">{{ linksRedirectCount }}</td>
        </tr>
        <tr>
            <td style="padding:6px 0;">OK</td>
            <td style="padding:6px 0;text-align:right;font-weight:600;">{{ linksOkCount }}</td>
        </tr>
        <tr>
            <td style="padding:6px 0;">Ignored</td>
            <td style="padding:6px 0;text-align:right;font-weight:600;">{{ linksIgnoredCount }}</td>
        </tr>
    </table>

    <twig:mail:button href="{{ consoleUrl }}">
        View Link Analysis
    </twig:mail:button>
{% endblock %}
