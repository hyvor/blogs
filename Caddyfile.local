# main domain
blogs.hyvor.test {

    encode gzip
    root * public
    tls internal
    php_fastcgi 127.0.0.1:9000
    file_server

}

# subdomain delivery
test.hyvorblogs.test {

    encode gzip
    root * public
    tls internal
    php_fastcgi 127.0.0.1:9000

}

# custom domain delivery
hyvorblogscustom.test {

    encode gzip
    root * public
    tls internal
    php_fastcgi 127.0.0.1:9000

}