{% if _blog.flashload %}
<script data-flashload-skip-script src="{{ 'flashload.js' | asset_url }}"></script>
<script data-flashload-skip-script>

    {# Calculate base path for Flashload #}
    {% set url_pieces = _blog.base_url | split('/', 4) %}
    {% set basePath = url_pieces | length > 3 ? url_pieces[3] : "" %}

    window.addEventListener("DOMContentLoaded", function() {
        Flashload.start({
            basePath: "{{ basePath }}"
        })
    });
</script>
{% endif %}

{% if _blog.code_foot %}
    {{  _blog.code_foot | template }}
{% endif %}

{% if _post.code_foot %}
    {{ _post.code_foot | template }}
{% endif %}

