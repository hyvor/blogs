{% extends "layouts.master" %}

{% block content %}
<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">Edit Blog</div>

                <div class="card-body">
                    {% if session.status is defined %}
                        <div class="alert alert-success" role="alert">
                            {{ session.status }}
                        </div>
                    {% endif %}
                    
                    <form action="/blogs/{{blog.id}}" method="post">
                        <!-- @csrf -->
                        <input type="hidden" name="_token" value="{{ csrf_token() }}">
                        <input type='hidden' name='_method' value='PUT'>
                        <div class="form-group">
                            <label for="">Website url</label>
                            <input type="text" name="websiteUrl" class="form-control" value="{{blog.website_url}}">
                        </div>

                        <div class="form-group">
                            <label for="">Title</label>
                            <input type="text" name="title" class="form-control" value="{{blog.title}}">
                        </div>

                        <div class="form-group">
                            <label for="">Short Description</label>
                            <textarea name="description" id="" cols="30" rows="10" class="form-control">
                            {{ blog.short_description }}    
                            </textarea>
                        </div>

                        <div class="form-group">
                            <label for="">Select a theme</label>
                            <select class="form-control" name="theme">
                                  {% for theme in themes %}
                                      {% if theme.id == blog.theme_id %}
                                          <option value="{{theme.id}}" selected>{{theme.name}}</option>
                                      {% else %}
                                          <option value="{{theme.id}}" >{{theme.name}}</option>
                                      {% endif %}
                                  {% endfor %}
                            </select>
                        </div>
                        <button type="submit" class="btn btn-primary">Submit</button>
                    </form>
                    
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}