{% extends "layouts.master" %}

{% block content %}
<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">View Post twig</div>

                <div class="card-body">
                    {% if session.status is defined %}
                        <div class="alert alert-success" role="alert">
                            {{ session.status }}
                        </div>
                    {% endif %}

                    <h2>{{post.title}}</h2>

                    <p>Published At: {{ post.published_at|date("m/d/Y") }}</p>
                    <br>
                    <div>
                        {{post.body}}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}