{% extends "layouts.master" %}

{% block content %}
<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">Edit Post twig</div>

                <div class="card-body">
                    {% if session.status is defined %}
                        <div class="alert alert-success" role="alert">
                            {{ session.status }}
                        </div>
                    {% endif %}
                    
                    <form action="/posts/{{post.id}}" method="post">
                        <!-- @csrf -->
                        <input type="hidden" name="_token" value="{{ csrf_token() }}">
                        <input type='hidden' name='_method' value='PUT'>
                        <div class="form-group">
                            <label for="">Post Title</label>
                            <input type="text" name="title" class="form-control" value="{{post.title}}">
                        </div>

                        <div class="form-group">
                            <label for="">Post Body</label>
                            <textarea name="body" id="" cols="30" rows="10" class="form-control">{{post.body}}</textarea>
                        </div>

                        <div class="form-group">
                            <label for="">Publish At</label>
                            <input type="date" name="published_at" class="form-control" value="{{ post.published_at|date('m/d/Y') }}">
                        </div>
                        
                        <button type="submit" class="btn btn-primary">Submit</button>
                    </form>
                    
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}