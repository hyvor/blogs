# Set these variables:
APP_SECRET=
POSTGRES_PASSWORD=
DOMAIN_APP=
DELIVERY_URL=
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Storage (S3-compatible: Cloudflare R2, DigitalOcean Spaces, Minio, etc.)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_BUCKET=
S3_USE_PATH_STYLE_ENDPOINT=false

# Default config to work with the compose.yaml Postgres service
DATABASE_URL="postgresql://postgres:${POSTGRES_PASSWORD}@127.0.0.1:5432/hyvor_blogs?serverVersion=16&charset=utf8"

# Following variables have sensible defaults for production:
DEPLOYMENT=on-prem
APP_ENV=prod
LOG_LEVEL=info
TRUSTED_PROXIES=127.0.0.1
