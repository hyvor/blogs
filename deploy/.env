# Set these variables:
APP_SECRET=
POSTGRES_PASSWORD=
DOMAIN_APP=
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Default config to work with the compose.yaml Postgres service
DATABASE_URL="postgresql://postgres:${POSTGRES_PASSWORD}@postgres:5432/hyvor_blogs?serverVersion=16&charset=utf8"

# Following variables have sensible defaults for production:
APP_ENV=prod
LOG_LEVEL=info
MERCURE_JWT_SECRET=${APP_SECRET}

# TLS_MODE: auto (default), external, manual, or disabled. See https://blogs.hyvor.com/hosting/deploy#tls
# For manual mode, mount your certificate/key at /certs/cert.pem and /certs/key.pem (see compose.yaml)
TLS_MODE=auto

# SMTP configuration (e.g., link analysis notifications)
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=

# Integrations
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
SENTRY_DSN=
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=