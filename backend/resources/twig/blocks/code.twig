<pre
    style="{{ data.pre.style }}"
    onmouseenter="{{ data.pre.onmouseenter }}"
    onmouseleave="{{ data.pre.onmouseleave }}"
    class="{{ data.pre.class }}"
    data-language="{{ data.language }}"
    data-annotations="{{ data.annotations }}"
    data-name="{{ data.name }}"
><code>{{ data.code | raw }}</code></pre>