{
    "name": "hyvor/blogs",
    "type": "project",
    "description": "Hyvor Blogs",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "ext-bcmath": "*",
        "ext-ctype": "*",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-fileinfo": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pcre": "*",
        "ext-pdo": "*",
        "ext-tokenizer": "*",
        "ext-xml": "*",
        "doctrine/dbal": "^3.6",
        "erusev/parsedown-extra": "^0.8.1",
        "fakerphp/faker": "^1.9.1",
        "filament/filament": "^2.0",
        "guzzlehttp/guzzle": "^7.0.1",
        "http-interop/http-factory-guzzle": "^1.2",
        "hyvor/laravel-filterq": "^1.0",
        "hyvor/laravel-hyvor-connecter": "^1.1.4",
        "hyvor/laravel-json-meta": "0.0.3",
        "hyvor/php-json-exporter": "^0.0.3",
        "hyvor/php-svg-icons": "1.0.0",
        "hyvor/phrosemirror": "1.0.0-alpha-4",
        "hyvor/scssphp": "2.0.2",
        "intervention/image": "^2.7",
        "laravel/framework": "^10.0",
        "laravel/horizon": "^5.10",
        "laravel/scout": "^9.4",
        "laravel/telescope": "^4.6",
        "laravel/tinker": "^2.7",
        "league/flysystem-aws-s3-v3": "^3.0",
        "masterminds/html5": "^2.7",
        "meilisearch/meilisearch-php": "1.1.1",
        "nelexa/zip": "^4.0",
        "openai-php/laravel": "^0.6.3",
        "padaliyajay/php-autoprefixer": "^1.3",
        "predis/predis": "^1.1",
        "scrivo/highlight.php": "v9.18.1.9",
        "sentry/sentry-laravel": "^3.8",
        "spatie/invade": "^1.1",
        "spatie/laravel-ignition": "^2.0",
        "symfony/css-selector": "^6.0",
        "symfony/dom-crawler": "6.2.7",
        "symfony/http-client": "^6.1",
        "symfony/http-foundation": "^6.0",
        "symfony/mailgun-mailer": "^6.1",
        "symfony/process": "^6.0",
        "symfony/yaml": "^6.0",
        "twig/intl-extra": "^3.4",
        "twig/string-extra": "^3.3",
        "twig/twig": "^2.0",
        "ueberdosis/tiptap-php": "^1.1",
        "unsplash/unsplash": "^3.2",
        "vlucas/phpdotenv": "^5.4"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.6",
        "friendsofphp/php-cs-fixer": "^3.8",
        "laravel/pint": "^1.1",
        "laravel/sail": "^1.0.1",
        "mockery/mockery": "^1.4.2",
        "nunomaduro/collision": "^7.0",
        "nunomaduro/larastan": "^2.0",
        "pestphp/pest": "^2.0",
        "pestphp/pest-plugin-laravel": "^2.0",
        "pestphp/pest-plugin-mock": "^2.0",
        "phpstan/phpstan": "^1.10.12",
        "phpstan/phpstan-strict-rules": "^1.5",
        "plannr/laravel-fast-refresh-database": "^0.0.3"
    },
    "autoload": {
        "psr-4": {
            "Project\\": "src/",
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",

            "Database\\Seeders\\": "database/seeders/",

            "Hyvor\\SyntaxHighlighter\\": "packages/highlighter/src/"
        },

        "Database\\Seeders\\": "database/seeders/",
        "Hyvor\\Auth\\": "packages/hyvor/auth/src/",
        "Hyvor\\FilterQ\\": "packages/hyvor/filter-q"
        
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],

        "serve": "concurrently \"php artisan serve --host=blogs.hyvor.test --port=8080\" \"php artisan serve --host=test.hyvorblogs.test --port=8081\"",
        "expose": "ngrok http 8080",
        "test": "vendor/bin/pest -p",
        "coverage": "vendor/bin/pest --coverage -p",
        "pint": "vendor/bin/pint",
        "minio": "minio server storage/app/minio"
    },
    "repositories": [
        {"type": "composer", "url": "https://hyvor.repo.repman.io"}
    ],
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
